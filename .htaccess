# Mundial Refrigeração — LPs estáticas (Apache / cPanel)
# Fonte única dos cabeçalhos de segurança, cache e compressão. Não duplique a CSP em <meta>.
# Ao incluir GTM, GA4, Google Ads, pixel ou qualquer recurso externo, adicione as origens
# exatas nas diretivas correspondentes da Content-Security-Policy antes de publicar.

# SymLinksIfOwnerMatch é exigido pelo mod_rewrite em .htaccess; sem ele o Apache responde 403 em tudo (AH00670)
Options -Indexes +SymLinksIfOwnerMatch
DirectoryIndex index.html
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType application/xml .xml
  AddCharset utf-8 .css .js .svg .xml .txt
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS somente no domínio de produção (não afeta testes locais)
  RewriteCond %{HTTP_HOST} ^produto\.mundialrefrigeracaogo\.com\.br$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Arquivos internos do repositório nunca são servidos (caso o clone fique na raiz do site)
  RewriteRule (^|/)\.(git|gitignore|cpanel\.yml|nojekyll|DS_Store|ht[a-z]+)(/|$) - [R=404,L]
  RewriteRule ^(README\.md|scripts/) - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  # CSP — origens por finalidade (tudo o mais é bloqueado):
  #  script-src : 'self'; hash do script inline de consentimento (python3 scripts/csp.py); googletagmanager.com
  #               (GTM GTM-T6JJ5MPM + gtag G-YPNLP0WT4K, carregados por consent.js só após consentimento); *.clarity.ms
  #               (Clarity yqihasm6oq); spar-hazel.vercel.app (spar-track.js, só com Marketing); tagmanager.google.com (modo Preview do GTM).
  #  connect-src/img-src : GA4 com recursos de publicidade e Clarity (guias oficiais do Google e da Microsoft).
  #  style-src/font-src  : origens do Google usadas apenas pelo modo Preview do GTM.
  #  frame-src  : googletagmanager.com (exigido pelas tags do Google Analytics com recursos de publicidade).
  #  O botão de WhatsApp é um link para spar-hazel.vercel.app/l/... (navegação): não entra em connect-src nem form-action.
  # Tags "HTML personalizado" e variáveis JavaScript personalizadas do GTM são bloqueadas por esta política.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-20xZukDrGRW4MtdGyp56rckguYwdq7rBCIjIpzuKlL0=' https://www.googletagmanager.com https://tagmanager.google.com https://*.clarity.ms https://spar-hazel.vercel.app; style-src 'self' https://www.googletagmanager.com https://tagmanager.google.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com https://*.google.com.br https://*.g.doubleclick.net https://ssl.gstatic.com https://www.gstatic.com https://*.clarity.ms https://c.bing.com; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com https://*.google.com.br https://*.g.doubleclick.net https://pagead2.googlesyndication.com https://*.clarity.ms https://c.bing.com; frame-src https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  # HSTS só em respostas HTTPS, sem includeSubDomains/preload (subdomínios do domínio não foram verificados)
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"

  # HTML sempre revalidado; CSS/JS versionados por ?v= (scripts/versionar.sh); mídia e fontes em cache longo
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json application/xml text/xml image/svg+xml image/x-icon image/vnd.microsoft.icon
</IfModule>
